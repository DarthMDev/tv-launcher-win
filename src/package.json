{
  "name": "toon-valley-launcher",
  "productName": "Toon Valley Launcher",
  "version": "2.2.3",
  "description": "Toon Valley Launcher",
  "main": "src/main/main.js",
  "private": true,
  "license": "BSD-3-Clause",
  "author": {
    "name": "Toon Valley",
    "url": "https://toonvalley.net"
  },
  "homepage": "https://toonvalley.net",
  "build": {
    "appId": "net.toonvalley.launcher",
    "productName": "Toon Valley Launcher",
    "electronVersion": "45.1.0",
    "files": [
      "src/**",
      "assets/**",
      "config/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Game",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico"
    }
  }
}
